# Server-side only (Vercel functions and the Vite dev middleware). Never import this in src/.
# DEMO_KEY is heavily rate limited (about 30 DONKI requests per hour per IP).
# Get a key at https://api.nasa.gov and set it as NASA_API_KEY in the Vercel project.
NASA_API_KEY=DEMO_KEY

# Server-side only; get a key at https://aistudio.google.com/apikey.
# Used only by api/live-token.ts; also set it in the Vercel project.
GEMINI_API_KEY=
